
# TLS Server Configuration
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000

# SSL/TLS Certificate Configuration
CERT_FILE=certs/service_center_cert.pem
KEY_FILE=certs/service_center_key.pem
CA_FILE=certs/ca_cert.pem
# Client certificate mode: required | optional | none
TLS_CLIENT_CERT_MODE=required

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=mioty_user
MQTT_PASSWORD=secure_password
BASE_TOPIC=mioty
MQTT_IN_QUEUE_MAXSIZE=5000
MQTT_OUT_QUEUE_MAXSIZE=5000
MQTT_QUEUE_PUT_TIMEOUT_SECONDS=1.5
MQTT_PUBLISH_MAX_RETRIES=5
MQTT_PUBLISH_RETRY_BASE_DELAY_SECONDS=0.5
MQTT_PUBLISH_RETRY_MAX_DELAY_SECONDS=8.0

# Monitoring / Alert thresholds
MONITOR_QUEUE_WARN_PCT=65
MONITOR_QUEUE_CRIT_PCT=85
MONITOR_RETRY_FAIL_WARN_PCT=5
MONITOR_RETRY_FAIL_CRIT_PCT=20
MONITOR_DB_WRITE_LATENCY_WARN_MS=500
MONITOR_DB_WRITE_LATENCY_CRIT_MS=1500
MONITOR_MQTT_RECONNECT_WARN_PER_HOUR=3
MONITOR_MQTT_RECONNECT_CRIT_PER_HOUR=8

# Application Configuration
SENSOR_CONFIG_FILE=endpoints.json
STATUS_INTERVAL=300
DEDUPLICATION_DELAY=2.0
ATTACH_RECONCILE_INTERVAL_SECONDS=60
ATTACH_RETRY_MIN_INTERVAL_SECONDS=120
ATTACH_RESPONSE_TIMEOUT_SECONDS=12
ATTACH_POST_CONNECT_RETRY_DELAY_SECONDS=8

# Web Interface Configuration
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=false

# Auto-detach Configuration
AUTO_DETACH_ENABLED=true
AUTO_DETACH_TIMEOUT=259200
AUTO_DETACH_HOURS=72
AUTO_DETACH_WARNING_TIMEOUT=129600
AUTO_DETACH_WARNING_HOURS=36
AUTO_DETACH_CHECK_INTERVAL=3600

# Optional modules
OMS_ENABLED=true
BS_UPTIME_PANEL_ENABLED=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/bssci_service.log

# Telemetry Source
# auto | runtime | influx
TELEMETRY_SOURCE=auto

# InfluxDB (optional - needed if TELEMETRY_SOURCE=influx/auto)
INFLUX_ENABLED=false
INFLUXDB_URL=http://influxdb2:8086
INFLUXDB_ORG=
INFLUXDB_BUCKET=
INFLUXDB_TOKEN=
INFLUXDB_VERIFY_SSL=true
INFLUX_UPTIME_MEASUREMENT=bssci_bs_uptime
INFLUX_UPTIME_FIELD=status
INFLUX_UPTIME_EUI_TAG=eui
# Optional custom Flux query. If set, this takes precedence.
# Query should return rows with time+event+eui (or _time+_value+eui).
INFLUX_UPTIME_QUERY=
INFLUX_INVENTORY_WRITE_ENABLED=true
INFLUX_INVENTORY_MEASUREMENT=bssci_inventory_events
INFLUX_SNAPSHOT_ENABLED=true
INFLUX_SNAPSHOT_INTERVAL_SECONDS=60
INFLUX_SNAPSHOT_MEASUREMENT=bssci_inventory_snapshot

# TimescaleDB/PostgreSQL (recommended for multi-tenant operational data)
TIMESCALE_ENABLED=false
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=bssci
TIMESCALE_USER=bssci_user
TIMESCALE_PASSWORD=change_me
TIMESCALE_SSLMODE=disable
TIMESCALE_DEFAULT_TENANT=default
TIMESCALE_INVENTORY_WRITE_ENABLED=true
TIMESCALE_TELEMETRY_WRITE_ENABLED=true
TIMESCALE_SNAPSHOT_ENABLED=true
TIMESCALE_SNAPSHOT_INTERVAL_SECONDS=60
TIMESCALE_RETENTION_ENABLED=true
TIMESCALE_TELEMETRY_RETENTION_DAYS=90
TIMESCALE_INVENTORY_RETENTION_DAYS=365
TIMESCALE_COMPRESSION_ENABLED=true
TIMESCALE_COMPRESSION_AFTER_DAYS=7
TIMESCALE_UPLINK_QUEUE_MAXSIZE=10000
TIMESCALE_UPLINK_BATCH_SIZE=200
TIMESCALE_UPLINK_WRITE_MAX_RETRIES=5
TIMESCALE_UPLINK_RETRY_BASE_SECONDS=0.5
TIMESCALE_UPLINK_RETRY_MAX_SECONDS=10.0

# Grafana (optional)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
GRAFANA_INTERNAL_URL=http://grafana:3000
GRAFANA_DASHBOARD_UID=service-center-overview
GRAFANA_DASHBOARD_SLUG=service-center-overview
GRAFANA_ORG_ID=1
GRAFANA_EMBED_ENABLED=true
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ORG_ROLE=Viewer
GRAFANA_PROXY_ENABLED=true
GRAFANA_PROXY_TIMEOUT_SECONDS=20
GRAFANA_PROXY_BEARER_TOKEN=
GRAFANA_PROXY_BASIC_USER=admin
GRAFANA_PROXY_BASIC_PASSWORD=admin
GRAFANA_HEALTH_PANEL_MAP=throughput:1,signal:2,active_sensors:3,active_base_stations:4,top_sensors:5,recent_messages:6

# Security
SECRET_KEY=your-secret-key-here
SESSION_COOKIE_SECURE=false
AUTH_SESSION_TIMEOUT_MINUTES=30
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=8
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
AUTH_API_RATE_LIMIT_REQUESTS=300
AUTH_API_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_AUDIT_EXPORT_MAX_ROWS=50000
